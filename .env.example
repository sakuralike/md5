APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
DATABASE_URL=mysql+pymysql://password_detective:password_detective@mysql:3306/password_detective
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_NAMESPACE=password-detective
NOTIFICATION_BACKEND=log
BROWSER_COOKIE_SECURE=false
ACCOUNT_TOKEN_TTL_MINUTES=30
CANDIDATE_SECRET_KEY_VERSION=v1
DAILY_REVEAL_QUOTA=5
SUBMISSION_PENDING_POINTS=1
VERIFICATION_REWARD_POINTS=1
DESKTOP_CHALLENGE_TTL_SECONDS=300
DESKTOP_RECEIPT_CLOCK_SKEW_SECONDS=300
DESKTOP_MIN_CLIENT_VERSION=0.1.0
DESKTOP_MAX_INSTALLATIONS_PER_USER=10
DESKTOP_UPDATE_STORAGE_PATH=.local/desktop-updates
DESKTOP_UPDATE_MAX_ARTIFACT_BYTES=536870912
DESKTOP_UPDATE_DOWNLOAD_CACHE_SECONDS=86400
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
AUTO_CREATE_TABLES=false
LOG_LEVEL=INFO
WEB_API_BASE_URL=http://localhost:8000/api/v1
