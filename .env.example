# 本文件仅用于本地/集成环境。生产环境使用 docker-compose.production-secrets.yml 和文件型 Docker Secrets。
# 支持的 *_FILE 变量：APP_SECRET_KEY、DATABASE_URL、REDIS_URL、CANDIDATE_SECRET_KEY_VERSION、
# CANDIDATE_SECRET_KEYRING、CANDIDATE_SECRET_DEDUP_KEY、NOTIFICATION_WEBHOOK_SECRET、NOTIFICATION_SMTP_PASSWORD。
APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
DATABASE_URL=mysql+pymysql://password_detective:password_detective@mysql:3306/password_detective
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
CELERY_WORKER_CONCURRENCY=2
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_NAMESPACE=password-detective
NOTIFICATION_BACKEND=log
NOTIFICATION_WEBHOOK_URL=https://notifications.synthetic.example.com/deliveries
NOTIFICATION_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=10
NOTIFICATION_SMTP_HOST=smtp.synthetic.example.com
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_SECURITY=starttls
NOTIFICATION_SMTP_USERNAME=synthetic-user
NOTIFICATION_SMTP_PASSWORD=replace-with-provider-app-password
NOTIFICATION_SMTP_SENDER_EMAIL=no-reply@synthetic.example.com
NOTIFICATION_SMTP_SENDER_NAME=密码侦探社
NOTIFICATION_SMTP_TIMEOUT_SECONDS=10
BROWSER_COOKIE_SECURE=false
MAX_JSON_BODY_BYTES=1048576
ACCOUNT_TOKEN_TTL_MINUTES=30
REAUTHENTICATION_TTL_MINUTES=5
# 候选秘密轮换：KEYRING 为 JSON 版本映射，DEDUP_KEY 在轮换前后必须保持不变。
# 合成示例：CANDIDATE_SECRET_KEYRING={"v1":"synthetic-legacy-key-at-least-32","v2":"synthetic-current-key-at-least-32"}
CANDIDATE_SECRET_KEY_VERSION=v1
CANDIDATE_SECRET_KEYRING=
CANDIDATE_SECRET_DEDUP_KEY=
DAILY_REVEAL_QUOTA=5
AUTHORIZATION_DECLARATION_VERSION=authorization-v1
PRIVACY_EXPORT_TTL_MINUTES=15
PRIVACY_DELETION_GRACE_HOURS=168
PRIVACY_JOB_BACKEND=celery
SUBMISSION_PENDING_POINTS=1
VERIFICATION_REWARD_POINTS=1
DESKTOP_CHALLENGE_TTL_SECONDS=300
DESKTOP_RECEIPT_CLOCK_SKEW_SECONDS=300
DESKTOP_MIN_CLIENT_VERSION=0.1.0
DESKTOP_MAX_INSTALLATIONS_PER_USER=10
DESKTOP_UPDATE_STORAGE_PATH=.local/desktop-updates
DESKTOP_UPDATE_MAX_ARTIFACT_BYTES=536870912
DESKTOP_UPDATE_DOWNLOAD_CACHE_SECONDS=86400
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
AUTO_CREATE_TABLES=false
LOG_LEVEL=INFO
WEB_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAX_ARCHIVE_SIZE_BYTES=21474836480
