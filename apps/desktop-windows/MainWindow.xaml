<Window x:Class="PasswordDetective.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码侦探社-桌面端v1.0"
        Width="730"
        Height="591"
        MinWidth="730"
        MinHeight="591"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        FontFamily="Microsoft YaHei UI"
        FontSize="12"
        AllowDrop="True"
        DragOver="Window_OnDragOver"
        Drop="Window_OnDrop">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="7,6,7,7" />
            <Setter Property="BorderBrush" Value="#A8A8A8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#202020" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="BorderBrush" Value="#B8B8B8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="BorderBrush" Value="#B8B8B8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="#F4F4F4" />
            <Setter Property="BorderBrush" Value="#A8A8A8" />
            <Setter Property="Foreground" Value="#202020" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#202020" />
        </Style>
    </Window.Resources>

    <Grid Margin="7,5,7,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="137" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="用户信息" Padding="7,5,7,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="338" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="67" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="22" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="86" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="后端 API：" FontWeight="Bold" />
                    <TextBox Grid.Column="1" Text="{Binding ServerBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Content="测试连通性" Command="{Binding TestConnectivityCommand}" />
                </Grid>

                <Label Grid.Row="1" Grid.Column="0" Content="用户名/邮箱：" FontWeight="Bold" />
                <TextBox Grid.Row="1" Grid.Column="0" Margin="94,0,90,3" Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" HorizontalAlignment="Right" Width="81" Content="登录" Command="{Binding LoginCommand}" />

                <Label Grid.Row="2" Grid.Column="0" Content="账号密码：" FontWeight="Bold" />
                <PasswordBox x:Name="LoginPasswordBox" Grid.Row="2" Grid.Column="0" Margin="94,0,90,3" PasswordChanged="LoginPasswordBox_OnPasswordChanged" />

                <Label Grid.Row="3" Grid.Column="0" Content="TOTP 验证码（已启用时填写）：" FontWeight="Bold" />
                <TextBox Grid.Row="3" Grid.Column="0" Margin="210,0,24,0" MaxLength="8" Text="{Binding TotpCode, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Grid.Row="1" Grid.Column="1" Grid.RowSpan="3" Margin="7,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="24" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="昵称：" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Nickname}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="用户组：" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding UserGroup}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="等级：" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Level}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="贡献数量：" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ContributionCount}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="积分：" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Points}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="今日剩余配额：" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DailyQuota}" />
                </Grid>                <Grid Grid.Row="3" Grid.Column="1" Margin="7,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="158" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="设备 ID：" />
                    <TextBlock Grid.Column="1" Text="{Binding InstallationIdText}" Foreground="#999999" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding AccountStatus}" Foreground="#00A000" TextTrimming="CharacterEllipsis" />
                </Grid><Border Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" Margin="4,0,0,0" BorderBrush="#C4C4C4" BorderThickness="1" Background="#FAFAFA">
                    <TextBlock Text="用户&#x0a;头像" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                </Border>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.62*" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <GroupBox Header="第一步：选择压缩包" Height="160">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="29" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="74" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding SelectedFileDisplay, Mode=OneWay}" IsReadOnly="True" Foreground="#999999" />
                            <Button Grid.Column="1" Content="浏览…" Command="{Binding SelectFileCommand}" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="122" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="23" />
                                <RowDefinition Height="23" />
                                <RowDefinition Height="23" />
                                <RowDefinition Height="23" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="压缩包名：" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Result.FileName, TargetNullValue=未计算}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="压缩包大小：" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Result.FileSize, StringFormat={}{0:N0} 字节, TargetNullValue=未计算}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="包内文件：" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding VerificationResult.EntryCount, StringFormat={}包含 {0} 个文件, TargetNullValue=未验证}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="MD5：" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Result.Md5, TargetNullValue=未计算}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="SHA256：" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Result.Sha256, TargetNullValue=未计算}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>
                </GroupBox>

                <GroupBox Header="第二步：验证密码" Height="101">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="31" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="18" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="94" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="145" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="压缩包密码：" VerticalAlignment="Center" />
                            <PasswordBox x:Name="CandidatePasswordBox" Grid.Column="1" PasswordChanged="CandidatePasswordBox_OnPasswordChanged" />
                            <Button Grid.Column="2" Content="开始验证密码及解压测试" Command="{Binding VerifyCommand}" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding Status, StringFormat=执行进度：{0}}" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Grid.Row="2" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="15" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="第三步：结果与提交" Height="113">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="108" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding VerificationResult.Message, TargetNullValue=密码验证成功！}" Foreground="#008000" TextWrapping="Wrap" />
                            <TextBlock Text="当前登录/奖励状态：" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding RewardStatus}" TextWrapping="Wrap" />
                            <TextBlock Text="候选 ID（网页端生成后可填）：" Margin="0,3,0,0" />
                            <TextBox Text="{Binding CandidateId, UpdateSourceTrigger=PropertyChanged}" Height="23" />
                        </StackPanel>
                        <Button Grid.Column="1" Width="101" Height="62" VerticalAlignment="Center" Content="提交哈希值密码对" Command="{Binding SubmitReceiptCommand}" />
                    </Grid>
                </GroupBox>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <GroupBox Header="公告区" Height="306">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25" />
                            <RowDefinition Height="72" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="27" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding CurrentAnnouncementTitle}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <Image Grid.Row="1" Source="{Binding CurrentAnnouncementImageUrl}" Stretch="Uniform" MaxHeight="64" Margin="0,0,0,4" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding CurrentAnnouncementContent}" TextWrapping="Wrap" />
                        </ScrollViewer>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="上一条" Command="{Binding PreviousAnnouncementCommand}" />
                            <Button Content="下一条" Command="{Binding NextAnnouncementCommand}" />
                            <Button Content="查看详情" Command="{Binding OpenAnnouncementActionCommand}" IsEnabled="{Binding HasAnnouncementAction}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
                <GroupBox Header="项目支持" Height="75">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="26" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="后端可设置公告，桌面端支持文字/HTML说明和图片地址展示；压缩包、密码及密码摘要不会作为文件内容上传。" TextWrapping="Wrap" Foreground="#555555" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="检查更新" Command="{Binding CheckForUpdatesCommand}" />
                            <Button Content="下载升级包" Command="{Binding OpenUpdateDownloadCommand}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
