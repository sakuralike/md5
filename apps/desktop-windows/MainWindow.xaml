<Window x:Class="PasswordDetective.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码侦探社 · 本地验证" Height="820" Width="1020"
        MinHeight="680" MinWidth="840" WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="#165D8D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="#D6DFEB"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="#D6DFEB"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#112B46" Padding="34,24">
            <StackPanel>
                <TextBlock Text="密码侦探社" Foreground="White" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Windows 本地 ZIP / 7z 密码验证 · 文件内容与候选密码不会上传"
                           Foreground="#CFE8F6" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="34">
                <Border Background="#EAF4FA" BorderBrush="#B8D8E8" BorderThickness="1"
                        Padding="16" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="本机安装身份" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding InstallationStatus}" Foreground="#45657A"
                                   Margin="0,5,0,0" TextWrapping="Wrap" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#D6DFEB" BorderThickness="1"
                        Padding="26" CornerRadius="14" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="服务端登录与安装注册" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="登录令牌使用当前 Windows 用户的 DPAPI 加密保存；不会采集硬件序列号或 MAC 地址。"
                                   Foreground="#667085" Margin="0,8,0,14" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ServerBaseUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="API 基础地址"/>
                            <TextBox Grid.Column="2" Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" ToolTip="用户名或邮箱"/>
                            <PasswordBox x:Name="LoginPasswordBox" Grid.Column="4" PasswordChanged="LoginPasswordBox_OnPasswordChanged" ToolTip="账号密码"/>
                            <TextBox Grid.Column="6" Text="{Binding TotpCode, UpdateSourceTrigger=PropertyChanged}" ToolTip="管理员 TOTP（普通用户留空）"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="登录并注册安装" Command="{Binding LoginCommand}"/>
                            <Button Content="清除本地令牌" Command="{Binding LogoutCommand}" Background="#667085"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AccountStatus}" Foreground="#45657A" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#D6DFEB" BorderThickness="1"
                        Padding="26" CornerRadius="14" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="1. 选择压缩包" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="支持 ZIP 与 7z。客户端只读取本地文件，并限制文件大小、条目数、展开大小、压缩比和验证时长。"
                                   Foreground="#667085" Margin="0,8,0,16" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SelectedFile}" IsReadOnly="True"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="选择文件"
                                    Command="{Binding SelectFileCommand}" Margin="12,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#D6DFEB" BorderThickness="1"
                        Padding="26" CornerRadius="14" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="2. 输入候选密码并本地验证" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="成功必须同时完成目录枚举和受控内容读取；仅识别文件头不会判定成功。"
                                   Foreground="#667085" Margin="0,8,0,12" TextWrapping="Wrap"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="候选 ID（提交回执时必填）" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding CandidateId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                        </Grid>
                        <PasswordBox x:Name="CandidatePasswordBox"
                                     PasswordChanged="CandidatePasswordBox_OnPasswordChanged"
                                     ToolTip="候选密码仅在当前进程内用于本地验证，不写入日志或身份文件。"/>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="仅计算指纹" Command="{Binding CalculateCommand}"/>
                            <Button Content="验证候选密码" Command="{Binding VerifyCommand}" Background="#087A55"/>
                            <Button Content="验证并提交签名回执" Command="{Binding SubmitReceiptCommand}" Background="#6B3FA0"/>
                            <Button Content="取消" Command="{Binding CancelCommand}" Background="#B42318"/>
                        </StackPanel>
                        <ProgressBar Height="10" Margin="0,18,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding Progress}"/>
                        <TextBlock Text="{Binding Status}" Foreground="#667085" Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="White" BorderBrush="#D6DFEB" BorderThickness="1"
                            Padding="24" CornerRadius="14">
                        <StackPanel>
                            <TextBlock Text="3. 文件指纹" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="SHA-256（主指纹）" FontWeight="SemiBold" Margin="0,16,0,6"/>
                            <TextBox Text="{Binding Result.Sha256}" IsReadOnly="True"
                                     FontFamily="Consolas" TextWrapping="Wrap"/>
                            <TextBlock Text="MD5（历史兼容）" FontWeight="SemiBold" Margin="0,14,0,6"/>
                            <TextBox Text="{Binding Result.Md5}" IsReadOnly="True"
                                     FontFamily="Consolas" TextWrapping="Wrap"/>
                            <TextBlock Foreground="#667085" Margin="0,12,0,0" TextWrapping="Wrap">
                                <Run Text="文件："/><Run Text="{Binding Result.FileName}"/>
                                <LineBreak/>
                                <Run Text="大小："/><Run Text="{Binding Result.FileSize}"/><Run Text=" 字节"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" BorderBrush="#D6DFEB"
                            BorderThickness="1" Padding="24" CornerRadius="14">
                        <StackPanel>
                            <TextBlock Text="4. 本地验证结果" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,16,0,0" FontSize="18" FontWeight="SemiBold">
                                <Run Text="通过："/><Run Text="{Binding VerificationResult.Success}"/>
                            </TextBlock>
                            <TextBlock Foreground="#667085" Margin="0,12,0,0">
                                <Run Text="格式："/><Run Text="{Binding VerificationResult.ArchiveFormat}"/>
                            </TextBlock>
                            <TextBlock Foreground="#667085" Margin="0,6,0,0">
                                <Run Text="条目数："/><Run Text="{Binding VerificationResult.EntryCount}"/>
                            </TextBlock>
                            <TextBlock Foreground="#667085" Margin="0,6,0,0">
                                <Run Text="声明展开大小："/><Run Text="{Binding VerificationResult.TotalUncompressedBytes}"/>
                                <Run Text=" 字节"/>
                            </TextBlock>
                            <TextBlock Foreground="#667085" Margin="0,6,0,0">
                                <Run Text="受控读取："/><Run Text="{Binding VerificationResult.BytesSampled}"/>
                                <Run Text=" 字节"/>
                            </TextBlock>
                            <TextBlock Text="{Binding VerificationResult.Message}" Foreground="#45657A"
                                       Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
