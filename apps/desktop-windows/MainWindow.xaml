<Window x:Class="PasswordDetective.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码侦探社-桌面端v1.0" Height="760" Width="1180" MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="#F2F2F2" AllowDrop="True"
        DragOver="Window_OnDragOver" Drop="Window_OnDrop">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="#A8A8A8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#222222" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="#C8C8C8" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="#C8C8C8" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="#ECECEC" />
            <Setter Property="BorderBrush" Value="#A8A8A8" />
            <Setter Property="Foreground" Value="#222222" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#242424" />
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" Padding="10,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Border Width="30" Height="30" Background="#9E42E8" CornerRadius="7" Margin="0,0,8,0">
                        <TextBlock Text="盾" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="密码侦探社 · 桌面端" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="本地验证与安全贡献" FontSize="11" Foreground="#777777" />
                    </StackPanel>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ClientVersionText, StringFormat=版本 {0}}" Foreground="#777777" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <GroupBox Grid.Row="1" Header="用户信息" Margin="0,8,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,8,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="后端 API：" FontWeight="Bold" />
                    <TextBox Grid.Column="1" Text="{Binding ServerBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Content="测试连通性" Command="{Binding TestConnectivityCommand}" />
                </Grid>
                <Grid Grid.Column="0" Grid.Row="1" Grid.RowSpan="3" Margin="0,0,10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="用户名/邮箱：" FontWeight="Bold" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Row="1" Content="账号密码：" FontWeight="Bold" />
                    <PasswordBox x:Name="LoginPasswordBox" Grid.Row="1" Grid.Column="1" PasswordChanged="LoginPasswordBox_OnPasswordChanged" />
                    <Label Grid.Row="2" Content="TOTP 验证码：" FontWeight="Bold" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TotpCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" />
                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" Content="登录" Command="{Binding LoginCommand}" Height="92" />
                </Grid>
                <Grid Grid.Column="1" Grid.Row="1" Grid.RowSpan="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="130" /><ColumnDefinition Width="110" /><ColumnDefinition Width="130" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="昵称：" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Nickname}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="用户组：" /><TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding UserGroup}" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="等级：" /><TextBlock Grid.Row="0" Grid.Column="5" Text="{Binding Level}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="贡献数量：" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ContributionCount}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="积分：" /><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Points}" />
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="每日剩余配额：" /><TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding DailyQuota}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="总哈希值：" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalHashes}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="邮箱：" /><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Email}" />
                    <TextBlock Grid.Row="2" Grid.Column="4" Text="状态：" /><TextBlock Grid.Row="2" Grid.Column="5" Text="{Binding AccountStatus}" Foreground="#008000" />
                </Grid>
                <TextBlock Grid.Column="0" Grid.Row="0" Grid.RowSpan="4" VerticalAlignment="Bottom" Margin="80,0,0,0" Text="{Binding InstallationStatus, StringFormat=设备 ID：{0}}" FontSize="10" Foreground="#888888" />
                <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="4" Margin="8,0,0,0" BorderBrush="#C8C8C8" BorderThickness="1" Background="#FAFAFA">
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="用户" FontSize="18" HorizontalAlignment="Center" /><TextBlock Text="头像" FontSize="18" HorizontalAlignment="Center" /></StackPanel>
                </Border>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <GroupBox Header="第一步：选择压缩包">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding SelectedFile, Mode=OneWay}" IsReadOnly="True" AllowDrop="True" ToolTip="将 ZIP、7z、RAR、TAR、GZ、TGZ、BZ/BZ2 文件拖入窗口，或点击浏览" />
                        <Button Grid.Row="0" Grid.Column="1" Content="浏览…" Command="{Binding SelectFileCommand}" />
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="详细信息：" FontWeight="Bold" />
                                <TextBlock Text="{Binding Result.FileName, StringFormat=压缩包名：{0}}" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding Result.FileSize, StringFormat=压缩包大小：{0}}" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding Result.Md5, StringFormat=MD5：{0}}" FontFamily="Consolas" Margin="0,3,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Result.Sha256, StringFormat=SHA256：{0}}" FontFamily="Consolas" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="包内文件：" FontWeight="Bold" />
                                <TextBlock Text="{Binding ArchiveSummary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="提示：文件内容与候选密码只在本机处理。" Foreground="#666666" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <Button Content="计算指纹" Command="{Binding CalculateCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </GroupBox>
                <GroupBox Header="第二步：验证密码">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Content="压缩包密码：" />
                        <PasswordBox x:Name="CandidatePasswordBox" Grid.Row="0" Grid.Column="1" PasswordChanged="CandidatePasswordBox_OnPasswordChanged" />
                        <Button Grid.Row="0" Grid.Column="2" Content="开始验证密码及解压测试" Command="{Binding VerifyCommand}" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Status, StringFormat=执行进度：{0}}" Margin="0,8,0,4" TextWrapping="Wrap" />
                        <ProgressBar Grid.Row="2" Grid.ColumnSpan="3" Height="18" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />
                    </Grid>
                </GroupBox>
                <GroupBox Header="第三步：结果与提交">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="密码验证成功！" FontWeight="Bold" Foreground="#008000" />
                            <TextBlock Text="{Binding VerificationResult.Message, StringFormat=验证结果：{0}}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RewardStatus, StringFormat=当前登录/奖励状态：{0}}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="候选 ID（网页端生成后可填）：" Margin="0,10,0,2" />
                            <TextBox Text="{Binding CandidateId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="提交哈希值密码对" Command="{Binding SubmitReceiptCommand}" Width="130" Height="62" />
                    </Grid>
                </GroupBox>
                <GroupBox Header="项目支持">
                    <TextBlock Text="{Binding InstallationStatus}" TextWrapping="Wrap" Foreground="#666666" />
                </GroupBox>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <GroupBox Header="公告区" Height="250">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0"><TextBlock Text="{Binding CurrentAnnouncementTitle}" FontWeight="Bold" /><Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshAnnouncementsCommand}" /></DockPanel>
                        <Image Grid.Row="1" Source="{Binding CurrentAnnouncementImageUrl}" Height="64" Margin="0,8,0,0" Stretch="UniformToFill" />
                        <ScrollViewer Grid.Row="2" Margin="0,8"><TextBlock Text="{Binding CurrentAnnouncementContent}" TextWrapping="Wrap" /></ScrollViewer>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="上一条" Command="{Binding PreviousAnnouncementCommand}" />
                            <Button Content="下一条" Command="{Binding NextAnnouncementCommand}" />
                            <Button Content="查看详情" Command="{Binding OpenAnnouncementActionCommand}" IsEnabled="{Binding HasAnnouncementAction}" />
                            <TextBlock Text="{Binding AnnouncementStatus}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#666666" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
                <GroupBox Header="运行状态">
                    <StackPanel>
                        <TextBlock Text="{Binding ApiConnectionStatus, StringFormat=API：{0}}" Foreground="#008000" />
                        <TextBlock Text="{Binding UpdateStatus, StringFormat=更新：{0}}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <Button Content="检查更新" Command="{Binding CheckForUpdatesCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        <Button Content="下载升级包" Command="{Binding OpenUpdateDownloadCommand}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding UpgradeNotice}" Foreground="#B54708" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="安全说明">
                    <TextBlock Text="后端可设置公告，桌面端支持文字/HTML说明和图片地址展示；压缩包、密码及密码摘要不会作为文件内容上传。" TextWrapping="Wrap" Foreground="#555555" />
                </GroupBox>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
