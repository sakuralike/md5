<Window x:Class="PasswordDetective.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="965"
        Height="770"
        MinWidth="965"
        MinHeight="770"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        FontFamily="Microsoft YaHei UI"
        FontSize="12"
        AllowDrop="True"
        DragOver="Window_OnDragOver"
        Drop="Window_OnDrop">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="7,5,7,6" />
            <Setter Property="BorderBrush" Value="#A8A8A8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#202020" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="BorderBrush" Value="#B8B8B8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="BorderBrush" Value="#B8B8B8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="#F4F4F4" />
            <Setter Property="BorderBrush" Value="#A8A8A8" />
            <Setter Property="Foreground" Value="#202020" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#202020" />
        </Style>
        <Style x:Key="AnnouncementSurfaceButton" TargetType="Button">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainLayout" Margin="8,5,8,7">
        <Grid.RowDefinitions>
            <RowDefinition Height="144" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="用户信息" Padding="7,4,7,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="344" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="241" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="23" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="169" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="后端 API：" FontWeight="Bold" />
                        <TextBox Grid.Column="1" Text="{Binding ServerBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Content="测试连通性" Command="{Binding TestConnectivityCommand}" />
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="145" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="用户名/邮箱：" FontWeight="Bold" />
                        <TextBox Grid.Column="1" Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Button Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Height="56" Content="登录" Command="{Binding LoginCommand}" />
                    <Grid Grid.Row="2" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="145" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="账号密码：" FontWeight="Bold" />
                        <PasswordBox x:Name="LoginPasswordBox" Grid.Column="1" PasswordChanged="LoginPasswordBox_OnPasswordChanged" />
                    </Grid>
                    <Grid Grid.Row="3" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="218" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="TOTP 验证码（已启用时填写）：" FontWeight="Bold" />
                        <TextBox Grid.Column="1" MaxLength="8" Text="{Binding TotpCode, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="91" />
                        <RowDefinition Height="25" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="#D0D0D0" BorderThickness="1" Background="#F5F5F5" Padding="6,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="20" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="昵称：" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Nickname}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="用户组：" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding UserGroup}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="等级：" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Level}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="贡献数量：" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ContributionCount}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="积分：" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Points}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="今日剩余配额：" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DailyQuota}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="总哈希值：" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalHashes}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="状态：" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding AccountStatus}" Foreground="#FF0000" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,3,0,0" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="设备 ID：" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding InstallationIdText}"
                                   Foreground="#999999"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                    </Grid>
                </Grid>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" MinWidth="428" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1*" MinWidth="249" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="160" />
                    <RowDefinition Height="102" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <GroupBox Grid.Row="0" Header="第一步">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="29" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding SelectedFileDisplay, Mode=OneWay}" IsReadOnly="True" Foreground="#999999" />
                            <Button Grid.Column="1" Content="浏览…" Command="{Binding SelectFileCommand}" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="20" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="详细信息：" FontWeight="Bold" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="包内文件：" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding VerificationResult.EntryCount, StringFormat={}包含 {0} 个文件, TargetNullValue=尚未验证}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="压缩包名：" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Result.FileName, TargetNullValue=尚未选择压缩包}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="目录：" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ArchiveSummary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="压缩包大小：" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Result.FileSize, StringFormat={}{0:N0} 字节, TargetNullValue=尚未计算}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="MD5：" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Result.Md5, TargetNullValue=尚未计算}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="SHA256：" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Result.Sha256, TargetNullValue=尚未计算}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="第二步">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="31" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="18" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="94" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="145" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="压缩包密码：" VerticalAlignment="Center" />
                            <PasswordBox x:Name="CandidatePasswordBox" Grid.Column="1" PasswordChanged="CandidatePasswordBox_OnPasswordChanged" />
                            <Button Grid.Column="2" Content="开始验证密码及解压测试" Command="{Binding VerifyCommand}" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding Status, StringFormat=执行进度：{0}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <ProgressBar Grid.Row="2" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="15" />
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="第三步">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="112" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding VerificationResult.Message, TargetNullValue=密码验证成功！}" Foreground="#008000" TextWrapping="Wrap" />
                            <TextBlock Text="压缩包完好！" />
                            <TextBlock Text="其余贡献要求！" />
                            <TextBlock Text="当前登录/奖励状态：" Margin="0,7,0,0" />
                            <TextBlock Text="{Binding RewardStatus}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            <TextBox Text="{Binding CandidateId, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" />
                        </StackPanel>
                        <Button Grid.Column="1" Width="104" Height="49" VerticalAlignment="Center" Content="提交哈希值密码对" Command="{Binding SubmitReceiptCommand}" />
                    </Grid>
                </GroupBox>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="79" />
                </Grid.RowDefinitions>
                <GroupBox Grid.Row="0" Header="公告区">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="125" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0"
                                Style="{StaticResource AnnouncementSurfaceButton}"
                                Command="{Binding RefreshAnnouncementsCommand}"
                                ToolTip="点击文字区刷新公告">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="{Binding CurrentAnnouncementTitle}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CurrentAnnouncementContent}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Button>
                        <TextBlock Grid.Row="1" Text="──────────下方是图片──────────" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Row="2"
                                Style="{StaticResource AnnouncementSurfaceButton}"
                                Command="{Binding OpenAnnouncementActionCommand}"
                                ToolTip="点击图片打开公告链接">
                            <Image Source="{Binding CurrentAnnouncementImageUrl}" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="运行状态">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding ApiConnectionStatus}" Foreground="#00C000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="插件市场" Click="OpenPluginMarketplace_OnClick" />
                            <Button Content="检查更新" Command="{Binding CheckForUpdatesCommand}" />
                            <Button Content="下载升级包" Command="{Binding OpenUpdateDownloadCommand}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
