<Window x:Class="PasswordDetective.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码侦探社 · 本地验证" Height="680" Width="980"
        MinHeight="600" MinWidth="820" WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="#165D8D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="#D6DFEB"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#112B46" Padding="34,24">
            <StackPanel>
                <TextBlock Text="密码侦探社" Foreground="White" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Windows 本地文件指纹 PoC · 文件内容不会上传"
                           Foreground="#CFE8F6" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="34">
                <Border Background="White" BorderBrush="#D6DFEB" BorderThickness="1" Padding="26" CornerRadius="14">
                    <StackPanel>
                        <TextBlock Text="1. 选择压缩包" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="MVP 首版验证范围为 ZIP 与 7z；本阶段只计算整个文件的 SHA-256 和 MD5。"
                                   Foreground="#667085" Margin="0,8,0,16" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SelectedFile}" IsReadOnly="True" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="选择文件" Command="{Binding SelectFileCommand}" Margin="12,0,0,0"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="计算指纹" Command="{Binding CalculateCommand}"/>
                            <Button Content="取消" Command="{Binding CancelCommand}" Background="#B42318"/>
                        </StackPanel>
                        <ProgressBar Height="10" Margin="0,18,0,0" Minimum="0" Maximum="100" Value="{Binding Progress}"/>
                        <TextBlock Text="{Binding Status}" Foreground="#667085" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#D6DFEB" BorderThickness="1" Padding="26" CornerRadius="14" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="2. 本地指纹结果" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="SHA-256（主指纹）" FontWeight="SemiBold" Margin="0,18,0,6"/>
                        <TextBox Text="{Binding Result.Sha256}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap"/>
                        <TextBlock Text="MD5（历史兼容）" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <TextBox Text="{Binding Result.Md5}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap"/>
                        <TextBlock Foreground="#667085" Margin="0,14,0,0">
                            <Run Text="文件："/><Run Text="{Binding Result.FileName}"/>
                            <Run Text="　大小："/><Run Text="{Binding Result.FileSize}"/><Run Text=" 字节"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
