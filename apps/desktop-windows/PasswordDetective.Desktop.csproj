<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="SharpCompress" Version="0.50.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Plugins\Protocol\pdpp-v1.schema.json" LogicalName="PasswordDetective.Desktop.Plugins.Protocol.pdpp-v1.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\scripts\desktop-plugin-isolation.ps1" Link="desktop-plugin-isolation.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildPdppSandboxCore" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="cargo build --manifest-path &quot;$(MSBuildProjectDirectory)\..\..\packages\pdpp-sandbox-core\Cargo.toml&quot; --release --locked"
          WorkingDirectory="$(MSBuildProjectDirectory)\..\.."
          EnvironmentVariables="CARGO_TERM_COLOR=never" />
  </Target>

  <Target Name="CopyPdppSandboxCore" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\packages\pdpp-sandbox-core\target\release\pdpp-sandbox-core.exe"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
