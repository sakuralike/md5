{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://password-detective.example/schemas/pdpp/v1/message.json",
  "title": "Password Detective Plugin Protocol v1 message",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/successResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "method": {
          "enum": [
            "initialize",
            "health/check",
            "lifecycle/migrate",
            "command/execute",
            "shutdown",
            "host/file/read",
            "host/file/digest",
            "host/file/write",
            "host/compute/hash",
            "host/storage/get",
            "host/storage/set",
            "host/storage/remove",
            "host/api/profile/read",
            "host/api/hash/read",
            "host/api/verification/submit",
            "host/ui/theme/apply",
            "host/ui/window/open",
            "host/ui/panel/show",
            "host/ui/notification/show",
            "host/clipboard/read",
            "host/clipboard/write"
          ]
        },
        "params": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "method": { "const": "initialize" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/initializeParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "health/check" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/emptyParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "lifecycle/migrate" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/migrateParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "command/execute" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/commandParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "shutdown" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/emptyParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "host/file/read" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/fileReadParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "host/file/digest" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/fileDigestParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "host/file/write" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/fileWriteParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "host/compute/hash" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/computeHashParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "host/storage/get" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/storageGetParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "host/storage/set" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/storageSetParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "host/storage/remove" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/storageGetParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "host/api/profile/read" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/emptyParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "host/api/hash/read" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/hashReadParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "host/api/verification/submit" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/verificationSubmitParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "host/ui/theme/apply" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/themeApplyParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "host/ui/window/open" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/windowOpenParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "host/ui/panel/show" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/panelShowParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "host/ui/notification/show" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/notificationShowParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "host/clipboard/read" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/emptyParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "host/clipboard/write" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/clipboardWriteParams" } } }
        }
      ]
    },
    "initializeParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "host_version", "plugin_id", "granted_capabilities"],
      "properties": {
        "protocol_version": { "const": "1.0" },
        "host_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "plugin_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
          "maxLength": 255
        },
        "granted_capabilities": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "commandParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "input"],
      "properties": {
        "command": { "type": "string", "minLength": 1, "maxLength": 128 },
        "input": {}
      }
    },
    "emptyParams": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "fileReadParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_ref", "offset", "count"],
      "properties": {
        "file_ref": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "offset": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 1, "maximum": 524288 }
      }
    },
    "storageGetParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" }
      }
    },
    "storageSetParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" },
        "value": {}
      }
    },
    "hashReadParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "enum": ["md5", "sha1", "sha256", "sha512"] },
        "digest": { "type": "string", "pattern": "^[a-fA-F0-9]{32,128}$" }
      }
    },
    "verificationSubmitParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "fingerprint_algorithm", "fingerprint_digest", "candidate_digest", "outcome", "archive_format"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 36, "maxLength": 36 },
        "fingerprint_algorithm": { "enum": ["md5", "sha1", "sha256", "sha512"] },
        "fingerprint_digest": { "type": "string", "pattern": "^[a-fA-F0-9]{32,128}$" },
        "candidate_digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "outcome": { "enum": ["success", "failure"] },
        "archive_format": { "enum": ["zip", "7z"] }
      }
    },
    "migrateParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_version", "to_version"],
      "properties": {
        "from_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "to_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
      }
    },
    "migrateStepResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "status", "attempt_count"],
      "properties": {
        "step_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 128 },
        "status": { "enum": ["completed", "skipped", "failed"] },
        "attempt_count": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "migrateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["migrated", "not_required", "failed"] },
        "steps": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/migrateStepResult" }
        }
      }
    },
    "fileDigestParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_ref", "algorithm"],
      "properties": {
        "file_ref": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "algorithm": { "enum": ["md5", "sha1", "sha256", "sha512"] }
      }
    },
    "fileWriteParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_ref", "offset", "data_base64"],
      "properties": {
        "file_ref": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "offset": { "type": "integer", "minimum": 0 },
        "data_base64": { "type": "string", "minLength": 1, "maxLength": 699052 }
      }
    },
    "computeHashParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "data_base64"],
      "properties": {
        "algorithm": { "enum": ["md5", "sha1", "sha256", "sha512"] },
        "data_base64": { "type": "string", "minLength": 1, "maxLength": 5592408 }
      }
    },
    "clipboardWriteParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "maxLength": 65536 }
      }
    },
    "themeApplyParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset"],
      "properties": {
        "preset": { "enum": ["light", "dark", "forest", "contrast", "ocean", "rose", "amber", "slate"] },
        "background_ref": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "background_opacity": { "type": "number", "minimum": 0.1, "maximum": 1 },
        "clear_background": { "type": "boolean" },
        "use_default_background": { "type": "boolean" }
      }
    },
    "windowOpenParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_id", "title", "width", "height"],
      "properties": {
        "window_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "width": { "type": "number", "minimum": 320, "maximum": 1920 },
        "height": { "type": "number", "minimum": 240, "maximum": 1200 },
        "modal": { "type": "boolean" }
      }
    },
    "panelShowParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panel_id", "title", "controls"],
      "properties": {
        "panel_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "width": { "type": "number", "minimum": 320, "maximum": 1920 },
        "height": { "type": "number", "minimum": 240, "maximum": 1200 },
        "controls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "label"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 64 },
              "type": { "enum": ["text", "label", "input", "checkbox", "button"] },
              "label": { "type": "string", "minLength": 1, "maxLength": 200 },
              "value": { "type": "string", "maxLength": 4096 },
              "checked": { "type": "boolean" }
            }
          }
        }
      }
    },
    "notificationShowParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "message"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "severity": { "enum": ["info", "success", "warning", "error"] },
        "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "successResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "result": {}
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "data": {}
          }
        }
      }
    }
  }
}
