{
  "uid": "password-detective-overview",
  "title": "Password Detective Overview",
  "tags": ["password-detective", "wp4"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "HTTP request rate", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(password_detective_http_requests_total[5m]))", "legendFormat": "requests/sec"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}},
    {"id": 2, "type": "timeseries", "title": "HTTP P95 latency", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(password_detective_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}},
    {"id": 3, "type": "timeseries", "title": "HTTP 5xx ratio", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(password_detective_http_requests_total{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(password_detective_http_requests_total[5m])), 0.001)", "legendFormat": "error ratio"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}},
    {"id": 4, "type": "timeseries", "title": "Worker queue depth", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "password_detective_worker_queue_depth", "legendFormat": "waiting tasks"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}},
    {"id": 5, "type": "timeseries", "title": "Dependency health", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "password_detective_dependency_up", "legendFormat": "{{dependency}}"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}},
    {"id": 6, "type": "stat", "title": "API uptime", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "password_detective_process_uptime_seconds", "legendFormat": "uptime"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "gridPos": {"h": 6, "w": 8, "x": 0, "y": 16}}
  ]
}
