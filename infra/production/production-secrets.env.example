# 仅包含非秘密生产部署参数；真实密钥由 Docker Secrets 文件提供。
PASSWORD_DETECTIVE_SECRET_DIR=/opt/password-detective-secrets
MYSQL_BIND_ADDRESS=127.0.0.1
REDIS_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306
REDIS_PORT=6379
API_PORT=8000
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
MAINTENANCE_FORCE_DISABLED=false
WEB_PORT=5173
ADMIN_PORT=5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
NOTIFICATION_BACKEND=log
# OpenBao Transit 平台签章。Token 文件由 PASSWORD_DETECTIVE_SECRET_DIR/desktop_plugin_signing_token 提供。
DESKTOP_PLUGIN_SIGNING_BACKEND=openbao_transit
DESKTOP_PLUGIN_SIGNING_URL=http://openbao:8200
DESKTOP_PLUGIN_SIGNING_KEY=password-detective-plugin-platform
# 大模型审核：openai_compatible 使用 /v1/chat/completions；anthropic_compatible 使用 /v1/messages。
DESKTOP_PLUGIN_LLM_REVIEW_PROVIDER=disabled
DESKTOP_PLUGIN_LLM_REVIEW_BASE_URL=
DESKTOP_PLUGIN_LLM_REVIEW_MODEL=
