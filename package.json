{
  "name": "password-detective",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:web": "pnpm --filter @password-detective/web dev",
    "dev:admin": "pnpm --filter @password-detective/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && pnpm exec tsc -p tsconfig.e2e.json --noEmit",
    "test": "pnpm -r test",
    "lint": "pnpm -r --if-present lint && pnpm exec eslint playwright.config.ts tests/e2e scripts/e2e && node ./scripts/check-frontend-policy.mjs",
    "e2e": "playwright test --project=web-chromium --project=admin-chromium",
    "e2e:firefox": "playwright test --project=web-firefox --project=admin-firefox",
    "e2e:webkit": "playwright test --project=web-webkit --project=admin-webkit",
    "e2e:cross-browser": "pnpm e2e && pnpm e2e:firefox && pnpm e2e:webkit",
    "e2e:headed": "playwright test --project=web-chromium --project=admin-chromium --headed",
    "e2e:report": "playwright show-report .local/playwright/report",
    "e2e:install": "playwright install chromium firefox webkit",
    "security:audit": "pwsh ./scripts/security-gate.ps1",
    "security:dast": "pwsh ./scripts/dast-security-gate.ps1",
    "security:release-policy": "python ./scripts/verify_release_security.py --policy-only --write-checksums",
    "recovery:drill": "pwsh ./scripts/recovery-drill.ps1",
    "candidate-secrets:drill": "python ./scripts/candidate-secret-rotation-drill.py && python ./scripts/verify_candidate_secret_rotation_evidence.py --report .local/candidate-secret-rotation-wp4-iteration-10/rotation-report.json --write-checksums",
    "performance:baseline": "pwsh ./scripts/performance-baseline.ps1",
    "monitoring:config": "python ./scripts/verify_monitoring_config.py --write-checksums",
    "worker:backlog-drill": "pwsh ./scripts/worker-backlog-drill.ps1",
    "stability:multi-instance": "pwsh ./scripts/multi-instance-stability-drill.ps1",
    "staging:readiness-plan": "pwsh ./scripts/staging-readiness-plan.ps1",
    "staging:evidence-contract": "pwsh ./scripts/staging-evidence-contract.ps1",
    "staging:target-adapter-contract": "pwsh ./scripts/staging-target-adapter-contract.ps1",
    "staging:platform-export-contract": "pwsh ./scripts/staging-platform-export-contract.ps1",
    "alertmanager:drill": "pwsh ./scripts/alertmanager-drill.ps1",
    "staging:evidence-archive-contract": "pwsh ./scripts/staging-evidence-archive-contract.ps1",
    "staging:smoke": "pwsh ./scripts/staging-smoke.ps1",
    "staging:monitoring-smoke": "pwsh ./scripts/staging-monitoring-smoke.ps1",
    "staging:api-ha-contract": "pwsh ./scripts/staging-api-ha-contract.ps1",
    "staging:api-ha-smoke": "pwsh ./scripts/staging-api-ha-smoke.ps1",
    "staging:resource-observation": "pwsh ./scripts/staging-resource-observation.ps1",
    "staging:topology-preflight": "pwsh ./scripts/staging-topology-preflight.ps1",
    "staging:stability-session": "pwsh ./scripts/staging-stability-session.ps1",
    "staging:formal-session": "python ./scripts/control_staging_formal_session.py",
    "staging:ha-preflight": "python ./scripts/control_staging_ha_execution.py",
    "staging:ha-capability-contract": "pwsh ./scripts/staging-ha-capability-contract.ps1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "autoprefixer": "^10.5.4",
    "eslint": "10.7.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "postcss": "^8.5.25",
    "shadcn-vue": "^2.8.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
